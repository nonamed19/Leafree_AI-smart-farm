pipeline {
    agent any

    environment {
        IMAGE_NAME = "leafree-backend"
        CONTAINER_NAME = "leafree-backend"

        // 실제 환경변수들
        JWT_SECRET = credentials('JWT_SECRET')

        DB_PASSWORD = credentials('DB_PASSWORD')

        MQTT_CLIENT_ID = credentials('MQTT_CLIENT_ID')
        MQTT_USERNAME = credentials('MQTT_USERNAME')
        MQTT_PASSWORD = credentials('MQTT_PASSWORD')

        FIREBASE_CREDENTIAL_JSON = credentials('FIREBASE_CREDENTIAL_JSON')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir('Web/backend') {
                    sh './gradlew clean build -x test'
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('Web/backend') {
                    sh '''
                        docker build -t $IMAGE_NAME .
                    '''
                }
            }
        }

        stage('Deploy (local)') {
            steps {
                sh '''
                    docker stop $CONTAINER_NAME || true
                    docker rm $CONTAINER_NAME || true
                    docker run -d --network="host" --name $CONTAINER_NAME \
                      -e JWT_SECRET=$JWT_SECRET \
                      -e DB_PASSWORD=$DB_PASSWORD \
                      -e MQTT_CLIENT_ID=$MQTT_CLIENT_ID \
                      -e MQTT_USERNAME=$MQTT_USERNAME \
                      -e MQTT_PASSWORD=$MQTT_PASSWORD \
                      -e GOOGLE_APPLICATION_CREDENTIALS=/app/firebase-key.json \
                      -v $FIREBASE_CREDENTIAL_JSON:/app/firebase-key.json:ro \
                      -p 9000:9000 \
                      $IMAGE_NAME
                '''
            }
        }
    }

    post {
        success {
            echo "✅ 배포 완료"
        }
        failure {
            echo "❌ 배포 실패"
        }
    }
}
